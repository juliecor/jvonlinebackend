APP_NAME=jvconline
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Dashboard uploads: 'public' (storage/app/public) or 's3' (AWS_* below; files go under AWS_ROOT in the bucket)
UPLOADS_DISK=public
# Buyers' IDs and payslips. Never a public disk: 'local' = storage/app/private (only the dashboard can open them)
DOCUMENTS_DISK=local
AWS_ROOT=jvconline
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jvconline.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The Next.js site (emailed links point here)
FRONTEND_URL=http://localhost:8713

# First admin login, created by `php artisan db:seed`. Change the password after the first login.
ADMIN_NAME="jvconline admin"
ADMIN_EMAIL=admin@jvconline.ph
ADMIN_PASSWORD=

# Johndorf's staff login (/johndorf/login), also created by `php artisan db:seed`. Skipped if the password is empty.
JOHNDORF_ADMIN_NAME="Johndorf Admin"
JOHNDORF_ADMIN_EMAIL=johndorf-admin@jvconline.ph
JOHNDORF_ADMIN_PASSWORD=

# Owner's master password: signs in to any account (admin, realty, agent). Leave empty on a public server.
MASTER_PASSWORD=

# Shared secret with the Next.js server (API_INTERNAL_KEY there); lets it pass the visitor's IP
INTERNAL_API_KEY=
